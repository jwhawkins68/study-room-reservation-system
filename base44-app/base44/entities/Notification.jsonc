{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": { "type": "string", "description": "Who the notice is for" },
    "reservation_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["cancelled_by_staff", "room_closed", "rebooked"], "description": "SRRS-19" },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "read_at": { "type": "string", "format": "date-time" },
    "emailed_at": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "kind", "title"],
  "rls": {
    "read": { "data.user_id": "{{user.id}}" },
    "create": false,
    "update": false,
    "delete": false
  }
}
