{
  "name": "RoomBlock",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room id"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "room_id",
    "starts_at",
    "ends_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}