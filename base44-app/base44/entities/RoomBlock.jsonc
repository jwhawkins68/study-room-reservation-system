// SRRS-12: staff closures for a time period. Written only by the manage-block function (building scope checked there).
{
  "name": "RoomBlock",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room id"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "room_id",
    "starts_at",
    "ends_at"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}
