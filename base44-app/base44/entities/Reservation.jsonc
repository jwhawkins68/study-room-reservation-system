// SRRS-6 to 10, 15, 16. Students read only their own bookings. Nobody writes directly:
// every create, change, and cancel goes through a backend function that enforces the booking rules.
{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room id"
    },
    "user_id": {
      "type": "string",
      "description": "Booker's user id"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_name": {
      "type": "string",
      "description": "Booker's name, shown to staff only"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "party_size": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "purpose": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled"
      ],
      "default": "confirmed"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "booker_role": {
      "type": "string",
      "enum": [
        "student",
        "staff"
      ],
      "default": "student",
      "description": "SRRS-15/16"
    },
    "booker_student_id": {
      "type": "string",
      "description": "Shown to staff only (SRRS-16)"
    },
    "cancelled_by_name": {
      "type": "string"
    },
    "cancel_reason": {
      "type": "string"
    }
  },
  "required": [
    "room_id",
    "user_id",
    "starts_at",
    "ends_at"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
