{
  "name": "BookingAttempt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "description": "ROOM_TAKEN, ROOM_BLOCKED, OVER_CAPACITY, TOO_LONG, IN_PAST, ROOM_INACTIVE, VALIDATION"
    }
  },
  "required": [
    "reason_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": false,
    "update": false,
    "delete": false
  }
}