{
  "info": {
    "name": "SRRS API",
    "description": "Study Room Reservation System API (Node/Express + Supabase).\n\n1. Fill in the collection variables: email, password (a Supabase test account), and start/end (a future time, ISO format like 2026-10-20T15:00:00Z).\n2. Start the API locally (cd api && npm run dev).\n3. Run '0. Log in' first. It saves your token, and every other request uses it.\n\nNever put the service_role / secret key in Postman exports or commit it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Log in (saves token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().access_token;",
              "if (t) { pm.collectionVariables.set('token', t); console.log('Token saved'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{publishableKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
          "host": [
            "{{supabaseUrl}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Logs in with Supabase Auth (same as the React app does) and saves the access token to the {{token}} variable. Set email and password in the collection variables first. Every other request uses that token."
      }
    },
    {
      "name": "Public",
      "item": [
