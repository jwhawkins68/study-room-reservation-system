            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Tester\",\n  \"studentId\": \"P00099999\",\n  \"email\": \"postman.test@pvamu.edu\",\n  \"password\": \"ChangeMe2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201), or 409 if this account already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
